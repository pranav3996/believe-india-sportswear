# MongoDB Atlas Configuration
# Get this from MongoDB Atlas: Connect -> Drivers -> Copy connection string
# Replace <password> with your database user password
# Add /believe-india at the end
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/believe-india

# NextAuth Configuration
# For local development
NEXTAUTH_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or use any random 32+ character string
NEXTAUTH_SECRET=your-super-secret-key-change-this-to-random-string-min-32-chars

# Cloudinary Configuration
# Get these from Cloudinary Dashboard: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
